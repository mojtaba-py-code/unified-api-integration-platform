# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.
#
# Every variable below is read by `app.core.config.Secrets`, which prefixes them
# all with UNIFIED_. All of them are optional — the platform starts without a
# `.env` at all — but the defaults are noted so you know what you are changing.

# Personal access token for the GitHub connector. Anonymous requests are capped
# at 60/hour; a token (no scopes needed for public repositories) lifts that to
# 5000/hour. Leave blank to stay anonymous.
UNIFIED_GITHUB_TOKEN=

# Path to the non-secret YAML settings file. Default: config.yaml
UNIFIED_CONFIG_PATH=config.yaml

# Where the SQLite database lives. Overrides `app.database_path` in config.yaml.
# Default: data/unified.db
UNIFIED_DATABASE_PATH=data/unified.db
